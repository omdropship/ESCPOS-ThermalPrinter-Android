<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/button_bluetooth_browse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cari Printer Bluetooth" />

    <Button
        android:id="@+id/button_bluetooth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cetak via Bluetooth" />

    <Button
        android:id="@+id/button_usb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cetak via USB" />

    <!-- Input IP & Port untuk Cetak Network/TCP -->
    <EditText
        android:id="@+id/edittext_tcp_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="IP Address (misal: 192.168.1.100)"
        android:inputType="text" />

    <EditText
        android:id="@+id/edittext_tcp_port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Port (misal: 9100)"
        android:inputType="number" />

    <Button
        android:id="@+id/button_tcp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cetak via Network (TCP)" />

</LinearLayout>
